# Copiar para .env e preencher. Nunca commitar o .env com valores reais.

DJANGO_SECRET_KEY=
DEBUG=1

# Só necessário quando DEBUG=0
# DATABASE_URL=postgresql://user:password@host:5432/dbname

APP_URL=http://127.0.0.1:8000/app/

# iMali.Way (Paytek) — ver "Partner Specifications" para os valores reais.
IMALI_API_KEY=
# PEM multi-linha, entre aspas (python-dotenv e o Railway aceitam):
# IMALI_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# MIIC...
# -----END PUBLIC KEY-----"
IMALI_PUBLIC_KEY=
IMALI_CLIENT_ID=
IMALI_WEBHOOK_SECRET=
IMALI_STORE_ACCOUNT_NUMBER=

EMAIL_HOST_PASSWORD=

# Cloudflare R2 (opcional — sem isto, uploads ficam no disco local)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=
# R2_PUBLIC_DOMAIN=
